    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4"
