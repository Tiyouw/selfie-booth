# Salin ke /etc/selfie-booth/api.env lalu sesuaikan.
# ALLOWED_ORIGINS: daftar domain frontend yang boleh POST/DELETE (dipisah koma).
# Link pendek otomatis memakai domain booth asal selama origin-nya terdaftar.
PORT=8787
DATA_DIR=/var/lib/selfie-booth
FRONTEND_ORIGIN=https://selfie.tiyoouw.app
ALLOWED_ORIGINS=https://selfie.tiyoouw.app,https://photobooth.himasif.id
TTL_DAYS=30
